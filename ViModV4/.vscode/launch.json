{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "type": "node",
            "request": "launch",
            "name": "ViMod Backend (MongoDB)",
            "program": "${workspaceFolder}/Backend/src/server.js",
            "cwd": "${workspaceFolder}/Backend",
            "envFile": "${workspaceFolder}/Backend/.env",
            "preLaunchTask": "ViMod: MongoDB",
            "console": "integratedTerminal",
            "skipFiles": [
                "<node_internals>/**"
            ]
        },
        {
            "type": "pwa-chrome",
            "request": "launch",
            "name": "ViMod Frontend (Live Server)",
            "url": "http://localhost:5500/Backend/Nucleo/Frontend/Vistas/2.%20Inicio%20de%20sesion.html",
            "webRoot": "${workspaceFolder}",
            "preLaunchTask": "ViMod: Frontend (Live Server)"
        }
    ]
}