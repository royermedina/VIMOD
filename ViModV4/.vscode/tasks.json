{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "ViMod: MongoDB",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start-mongodb.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vimod-mongodb",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^VI\\[MongoDB\\] STARTING",
          "endsPattern": "^VI\\[MongoDB\\] READY"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "vimod-services",
        "showReuseMessage": false
      }
    },
    {
      "label": "ViMod: Backend",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start-backend.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}/Backend"
      },
      "dependsOn": "ViMod: MongoDB",
      "dependsOrder": "sequence",
      "isBackground": true,
      "problemMatcher": {
        "owner": "vimod-backend",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^VI\\[Backend\\] STARTING",
          "endsPattern": "^VI\\[Backend\\] READY"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "vimod-services",
        "showReuseMessage": false
      }
    },
    {
      "label": "ViMod: Frontend (Live Server)",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoLogo",
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.vscode/start-live-server.ps1"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "isBackground": true,
      "problemMatcher": {
        "owner": "vimod-liveserver",
        "pattern": { "regexp": "^.*$" },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^VI\\[LiveServer\\] STARTING",
          "endsPattern": "^VI\\[LiveServer\\] READY"
        }
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "dedicated",
        "group": "vimod-services",
        "showReuseMessage": false
      }
    },
    {
      "label": "ViMod: Start All",
      "dependsOn": [
        "ViMod: Backend",
        "ViMod: Frontend (Live Server)"
      ],
      "dependsOrder": "sequence",
      "runOptions": {
        "instanceLimit": 1
      },
      "problemMatcher": [],
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": false,
        "panel": "shared",
        "showReuseMessage": false
      }
    }
  ]
}